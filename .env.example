# DebugDNA — environment variable reference
#
# Copy this file to .env.local and fill in your values.
# .env.local is never committed to source control.
#
# IMPORTANT: All Granite / watsonx.ai credentials are server-side only.
# They are never exposed to the browser or included in client bundles.

# ---------------------------------------------------------------------------
# IBM watsonx.ai / Granite (optional)
#
# When WATSONX_API_KEY is absent or empty, the Granite explainer silently
# returns undefined and the deterministic pipeline runs unaffected.
# ---------------------------------------------------------------------------

# IBM Cloud IAM API key.
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=

# watsonx.ai project ID.
# Obtain from your project's Manage → General settings page in IBM watsonx.
WATSONX_PROJECT_ID=

# (Optional) Granite model ID to use for explanation generation.
# Defaults to: ibm/granite-3-8b-instruct
# Change only if you have access to a different IBM Granite model.
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# (Optional) IBM watsonx.ai region.
# Defaults to: us-south
# Other supported values: eu-de, eu-gb, jp-tok, au-syd
WATSONX_REGION=us-south
